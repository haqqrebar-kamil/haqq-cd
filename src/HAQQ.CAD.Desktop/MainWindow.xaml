<Window x:Class="HAQQ.CAD.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HAQQ.CAD.Desktop"
        Title="{Binding Title}"
        Width="1440" Height="900" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        PreviewTextInput="Window_PreviewTextInput">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================== Ribbon ============================== -->
        <TabControl Grid.Row="0" SelectedIndex="1">
            <TabItem Header="FILE">
                <StackPanel Orientation="Horizontal" Margin="6,0">
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconNew}" Content="New" Command="{Binding NewCommand}" ToolTip="New drawing (Ctrl+N)" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconOpen}" Content="Open" Command="{Binding OpenCommand}" ToolTip="Open an HCAD drawing (Ctrl+O)" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconSave}" Content="Save" Command="{Binding SaveCommand}" ToolTip="Save (Ctrl+S)" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconSaveAs}" Content="Save As" Command="{Binding SaveAsCommand}" ToolTip="Save under a new name" />
                    <Border Width="1" Margin="6,6" Background="{StaticResource BorderBrush}" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconUnits}" Content="Units" Command="{Binding RunCommandCommand}" CommandParameter="UNITS" ToolTip="UNITS: inches, feet, mm, cm or meters, and display precision" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconCrosshair}" Content="Crosshair" Command="{Binding RunCommandCommand}" CommandParameter="CURSORSIZE" ToolTip="CURSORSIZE: crosshair size, 1 to 100 percent of the screen" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconShortcuts}" Content="Shortcuts" Command="{Binding RunCommandCommand}" CommandParameter="SHORTCUTS" ToolTip="SHORTCUTS: choose the short names you type to start each command" />
                </StackPanel>
            </TabItem>
            <TabItem Header="HOME">
                <StackPanel Orientation="Horizontal" Margin="6,0">
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconLine}" Content="Line" Command="{Binding RunCommandCommand}" CommandParameter="LINE" ToolTip="LINE (L)" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconPolyline}" Content="Polyline" Command="{Binding RunCommandCommand}" CommandParameter="PLINE" ToolTip="PLINE (PL)" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconRectangle}" Content="Rectangle" Command="{Binding RunCommandCommand}" CommandParameter="RECTANG" ToolTip="RECTANG (REC)" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconCircle}" Content="Circle &#x25BE;" Click="RibbonMenuButton_Click" ToolTip="CIRCLE (C): choose how to define the circle">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Center, Radius" Tag="CIRCLE" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Center, Diameter" Tag="CIRCLE D" Click="RibbonMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="2-Point" Tag="CIRCLE 2P" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="3-Point" Tag="CIRCLE 3P" Click="RibbonMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="Tan, Tan, Radius" Tag="CIRCLE TTR" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Tan, Tan, Tan" Tag="CIRCLE TTT" Click="RibbonMenuItem_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconArc}" Content="Arc &#x25BE;" Click="RibbonMenuButton_Click" ToolTip="ARC (A): choose how to define the arc">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="3-Point" Tag="ARC" Click="RibbonMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="Start, Center, End" Tag="ARC SCE" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Start, Center, Angle" Tag="ARC SCA" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Start, Center, Length" Tag="ARC SCL" Click="RibbonMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="Start, End, Angle" Tag="ARC SEA" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Start, End, Direction" Tag="ARC SED" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Start, End, Radius" Tag="ARC SER" Click="RibbonMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="Center, Start, End" Tag="ARC CSE" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Center, Start, Angle" Tag="ARC CSA" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Center, Start, Length" Tag="ARC CSL" Click="RibbonMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="Continue" Tag="ARC CONTINUE" Click="RibbonMenuItem_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Border Width="1" Margin="6,6" Background="{StaticResource BorderBrush}" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconMove}" Content="Move" Command="{Binding RunCommandCommand}" CommandParameter="MOVE" ToolTip="MOVE (M)" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconCopy}" Content="Copy" Command="{Binding RunCommandCommand}" CommandParameter="COPY" ToolTip="COPY (CO)" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconErase}" Content="Erase" Command="{Binding RunCommandCommand}" CommandParameter="ERASE" ToolTip="ERASE (E, Delete)" />
                    <Border Width="1" Margin="6,6" Background="{StaticResource BorderBrush}" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconUndo}" Content="Undo" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconRedo}" Content="Redo" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)" />
                    <Border Width="1" Margin="6,6" Background="{StaticResource BorderBrush}" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconZoom}" Content="Extents" Command="{Binding ZoomExtentsCommand}" ToolTip="Zoom extents (ZOOM, double-click the wheel)" />
                    <Border Width="1" Margin="6,6" Background="{StaticResource BorderBrush}" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconLayers}" Content="Layers" Command="{Binding RunCommandCommand}" CommandParameter="LAYER" ToolTip="LAYER (LA): open the layer table" />
                    <Border Width="1" Margin="6,6,12,6" Background="{StaticResource BorderBrush}" />
                    <!-- Layer, colour, linetype and lineweight: of new objects, or of what is selected -->
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0" Width="170">
                        <TextBlock Text="Layer" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,0,0,3" />
                        <ComboBox DropDownClosed="PropertyCombo_DropDownClosed" ItemsSource="{Binding Layers}" SelectedValuePath="Name"
                                  SelectedValue="{Binding Properties.SelectedLayerName, Mode=TwoWay}"
                                  ToolTip="The layer new objects are drawn on. With objects selected: their layer.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center" Background="{Binding ColorHex}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0" Width="120">
                        <TextBlock Text="Color" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,0,0,3" />
                        <ComboBox DropDownClosed="PropertyCombo_DropDownClosed" ItemsSource="{Binding Properties.ColorNames}"
                                  SelectedItem="{Binding Properties.SelectedColor, Mode=TwoWay}"
                                  ToolTip="Colour of new objects (ByLayer uses the layer colour). With objects selected: their colour.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"
                                                Background="{Binding Converter={StaticResource ColorNameToBrush}}"
                                                BorderBrush="{StaticResource DimTextBrush}" BorderThickness="1" />
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0" Width="140">
                        <TextBlock Text="Linetype" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,0,0,3" />
                        <ComboBox DropDownClosed="PropertyCombo_DropDownClosed" ItemsSource="{Binding Properties.LinetypeNames}"
                                  SelectedItem="{Binding Properties.SelectedLinetype, Mode=TwoWay}"
                                  ToolTip="Linetype of new objects (ByLayer uses the layer linetype). With objects selected: their linetype." />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0" Width="110">
                        <TextBlock Text="Lineweight" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,0,0,3" />
                        <ComboBox DropDownClosed="PropertyCombo_DropDownClosed" ItemsSource="{Binding Properties.LineweightNames}"
                                  SelectedItem="{Binding Properties.SelectedLineweight, Mode=TwoWay}"
                                  ToolTip="Line thickness of new objects in millimetres (ByLayer uses the layer lineweight). With objects selected: their lineweight." />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Plot" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,0,0,1" HorizontalAlignment="Center" />
                        <ToggleButton Style="{StaticResource FlagToggle}" Foreground="{StaticResource TextBrush}"
                                      Tag="{StaticResource GlyphPlot}" Content="{StaticResource GlyphNoPlot}"
                                      IsChecked="{Binding CurrentLayerPlots, Mode=TwoWay}"
                                      ToolTip="Plot switch of the current layer. Crossed out: the layer is shown on screen but will not be printed." />
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="DRAW">
                <StackPanel Orientation="Horizontal" Margin="6,0">
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconLine}" Content="Line" Command="{Binding RunCommandCommand}" CommandParameter="LINE" ToolTip="LINE (L)" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconPolyline}" Content="Polyline" Command="{Binding RunCommandCommand}" CommandParameter="PLINE" ToolTip="PLINE (PL)" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconRectangle}" Content="Rectangle" Command="{Binding RunCommandCommand}" CommandParameter="RECTANG" ToolTip="RECTANG (REC)" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconCircle}" Content="Circle &#x25BE;" Click="RibbonMenuButton_Click" ToolTip="CIRCLE (C): choose how to define the circle">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Center, Radius" Tag="CIRCLE" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Center, Diameter" Tag="CIRCLE D" Click="RibbonMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="2-Point" Tag="CIRCLE 2P" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="3-Point" Tag="CIRCLE 3P" Click="RibbonMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="Tan, Tan, Radius" Tag="CIRCLE TTR" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Tan, Tan, Tan" Tag="CIRCLE TTT" Click="RibbonMenuItem_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconArc}" Content="Arc &#x25BE;" Click="RibbonMenuButton_Click" ToolTip="ARC (A): choose how to define the arc">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="3-Point" Tag="ARC" Click="RibbonMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="Start, Center, End" Tag="ARC SCE" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Start, Center, Angle" Tag="ARC SCA" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Start, Center, Length" Tag="ARC SCL" Click="RibbonMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="Start, End, Angle" Tag="ARC SEA" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Start, End, Direction" Tag="ARC SED" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Start, End, Radius" Tag="ARC SER" Click="RibbonMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="Center, Start, End" Tag="ARC CSE" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Center, Start, Angle" Tag="ARC CSA" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Center, Start, Length" Tag="ARC CSL" Click="RibbonMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="Continue" Tag="ARC CONTINUE" Click="RibbonMenuItem_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </TabItem>
            <TabItem Header="MODIFY">
                <StackPanel Orientation="Horizontal" Margin="6,0">
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconMove}" Content="Move" Command="{Binding RunCommandCommand}" CommandParameter="MOVE" ToolTip="MOVE (M)" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconCopy}" Content="Copy" Command="{Binding RunCommandCommand}" CommandParameter="COPY" ToolTip="COPY (CO)" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconErase}" Content="Erase" Command="{Binding RunCommandCommand}" CommandParameter="ERASE" ToolTip="ERASE (E, Delete)" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconRotate}" Content="Rotate" Command="{Binding RunCommandCommand}" CommandParameter="ROTATE" ToolTip="ROTATE (RO): turn objects about a base point" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconMirror}" Content="Mirror" Command="{Binding RunCommandCommand}" CommandParameter="MIRROR" ToolTip="MIRROR (MI): reflect objects across a line" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconScale}" Content="Scale" Command="{Binding RunCommandCommand}" CommandParameter="SCALE" ToolTip="SCALE (SC): enlarge or reduce objects" />
                    <Border Width="1" Margin="6,6" Background="{StaticResource BorderBrush}" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconOffset}" Content="Offset" Command="{Binding RunCommandCommand}" CommandParameter="OFFSET" ToolTip="OFFSET (O): parallel copy at a distance" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconTrim}" Content="Trim" Command="{Binding RunCommandCommand}" CommandParameter="TRIM" ToolTip="TRIM (TR): click the part to remove; it is cut at the nearest crossings" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconExtend}" Content="Extend" Command="{Binding RunCommandCommand}" CommandParameter="EXTEND" ToolTip="EXTEND (EX): click near an end to lengthen it to the next object" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconFillet}" Content="Fillet" Command="{Binding RunCommandCommand}" CommandParameter="FILLET" ToolTip="FILLET (F): round the corner between two lines (radius 0 = sharp corner)" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconChamfer}" Content="Chamfer" Command="{Binding RunCommandCommand}" CommandParameter="CHAMFER" ToolTip="CHAMFER (CHA): cut the corner between two lines" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconExplode}" Content="Explode" Command="{Binding RunCommandCommand}" CommandParameter="EXPLODE" ToolTip="EXPLODE (X): turn polylines into lines and arcs" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconJoin}" Content="Join" Command="{Binding RunCommandCommand}" CommandParameter="JOIN" ToolTip="JOIN (J): connect selected lines, arcs and open polylines that touch end to end into one polyline" />
                    <Border Width="1" Margin="6,6" Background="{StaticResource BorderBrush}" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconUndo}" Content="Undo" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconRedo}" Content="Redo" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)" />
                </StackPanel>
            </TabItem>
            <TabItem Header="DIMENSION">
                <StackPanel Orientation="Horizontal" Margin="6,0">
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconDimLinear}" Content="Straight" Command="{Binding RunCommandCommand}" CommandParameter="DIM" ToolTip="DIM (DL): horizontal or vertical distance between two points. Place the line above or below for horizontal, beside for vertical." />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconDimAligned}" Content="Aligned" Command="{Binding RunCommandCommand}" CommandParameter="DIMALIGN" ToolTip="DIMALIGN (DA): true distance between two points, along the slope" />
                    <Border Width="1" Margin="6,6" Background="{StaticResource BorderBrush}" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconDimRadius}" Content="Radius" Command="{Binding RunCommandCommand}" CommandParameter="DIMRAD" ToolTip="DIMRAD (DR): radius of a circle or arc" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconDimDiameter}" Content="Diameter" Command="{Binding RunCommandCommand}" CommandParameter="DIMDIA" ToolTip="DIMDIA (DD): diameter of a circle or arc" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconDimAngle}" Content="Angle" Command="{Binding RunCommandCommand}" CommandParameter="DIMANGLE" ToolTip="DIMANGLE (DG): angle between two lines, or the angle an arc covers" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconDimArc}" Content="Arc Length" Command="{Binding RunCommandCommand}" CommandParameter="DIMARCLEN" ToolTip="DIMARCLEN (DARC): length along an arc" />
                    <Border Width="1" Margin="6,6" Background="{StaticResource BorderBrush}" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconDimChain}" Content="Chain" Command="{Binding RunCommandCommand}" CommandParameter="DIMCHAIN" ToolTip="DIMCHAIN (DC): carry on from the last dimension, end to end on one line" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconDimStack}" Content="Stack" Command="{Binding RunCommandCommand}" CommandParameter="DIMSTACK" ToolTip="DIMSTACK (DS): more dimensions from the same first point, each on its own line" />
                    <Border Width="1" Margin="6,6" Background="{StaticResource BorderBrush}" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconDimSize}" Content="Text Size" Command="{Binding RunCommandCommand}" CommandParameter="DIMSIZE" ToolTip="DIMSIZE: text height of dimensions (arrows follow it)" />
                </StackPanel>
            </TabItem>
            <TabItem Header="LAYERS">
                <StackPanel Orientation="Horizontal" Margin="6,0">
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconLayers}" Content="Layers" Command="{Binding RunCommandCommand}" CommandParameter="LAYER" ToolTip="LAYER (LA): open the layer table (on/off, freeze, lock, name, colour, lineweight)" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconLayers}" Content="New Layer" Command="{Binding AddLayerCommand}" ToolTip="Create a layer" />
                    <Border Width="1" Margin="6,6" Background="{StaticResource BorderBrush}" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconLinetype}" Content="Linetype" Command="{Binding RunCommandCommand}" CommandParameter="LINETYPE" ToolTip="LINETYPE (LT): Linetype Manager - see every linetype, build your own with sliders, edit or delete" />
                    <Button Style="{StaticResource RibbonButton}" Tag="{StaticResource IconLinetype}" Content="LT Scale" Command="{Binding RunCommandCommand}" CommandParameter="LTSCALE" ToolTip="LTSCALE (LTS): make every dash and gap in the drawing longer or shorter" />
                    <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="Current layer" Foreground="{StaticResource DimTextBrush}" FontSize="11" />
                        <TextBlock Text="{Binding CurrentLayerName}" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- ============================ Work area ============================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition x:Name="PropertiesColumn" Width="270" MinWidth="170" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Centre: the CAD canvas -->
            <Border Grid.Column="0" Background="#21252B" ClipToBounds="True">
                <local:CadCanvas x:Name="DrawingCanvas" />
            </Border>

            <GridSplitter x:Name="PropertiesSplitter" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Focusable="False" />

            <!-- Right edge: strip that folds the properties panel away to the right and brings it back -->
            <Border Grid.Column="3" Width="18" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0" Cursor="Hand" MouseLeftButtonDown="PropertiesToggle_Click"
                    ToolTip="Hide or show the Properties panel">
                <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">
                    <TextBlock x:Name="PropertiesToggleArrow" Text="&#x00BB;" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock x:Name="PropertiesToggleLabel" Text="PROPERTIES" Visibility="Collapsed" Margin="0,10,0,0" FontSize="10"
                               HorizontalAlignment="Center" Foreground="{StaticResource DimTextBrush}">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Right panel: properties -->
            <Border x:Name="PropertiesPanel" Grid.Column="2" Background="{StaticResource PanelBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource PanelHeader}" Text="PROPERTIES" />

                    <StackPanel Grid.Row="1" Margin="8,0,8,6">
                        <TextBlock Text="{Binding Properties.Header}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,3" />
                        <TextBlock Text="{Binding Properties.Hint}" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Layer" />
                            <ComboBox Grid.Column="1" DropDownClosed="PropertyCombo_DropDownClosed" ItemsSource="{Binding Properties.LayerNames}"
                                      SelectedItem="{Binding Properties.SelectedLayerName, Mode=TwoWay}"
                                      ToolTip="Layer of the selected objects. While drawing: the layer of the object being drawn. Otherwise: the current layer for new objects." />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Color" />
                            <ComboBox Grid.Column="1" DropDownClosed="PropertyCombo_DropDownClosed" ItemsSource="{Binding Properties.ColorNames}"
                                      SelectedItem="{Binding Properties.SelectedColor, Mode=TwoWay}"
                                      ToolTip="ByLayer uses the colour of the layer.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"
                                                Background="{Binding Converter={StaticResource ColorNameToBrush}}"
                                                BorderBrush="{StaticResource DimTextBrush}" BorderThickness="1" />
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Linetype" />
                            <ComboBox Grid.Column="1" DropDownClosed="PropertyCombo_DropDownClosed" ItemsSource="{Binding Properties.LinetypeNames}"
                                      SelectedItem="{Binding Properties.SelectedLinetype, Mode=TwoWay}"
                                      ToolTip="ByLayer uses the linetype of the layer." />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Lineweight" />
                            <ComboBox Grid.Column="1" DropDownClosed="PropertyCombo_DropDownClosed" ItemsSource="{Binding Properties.LineweightNames}"
                                      SelectedItem="{Binding Properties.SelectedLineweight, Mode=TwoWay}"
                                      ToolTip="Line thickness in millimetres. ByLayer uses the lineweight of the layer." />
                        </Grid>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl Margin="8,0,8,8" ItemsSource="{Binding Properties.Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{Binding Label}" />
                                        <TextBox x:Name="ValueBox" Grid.Column="1" KeyDown="EditBox_KeyDown"
                                                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 IsReadOnly="{Binding IsReadOnly, Mode=OneWay}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                            <Setter TargetName="ValueBox" Property="Background" Value="Transparent" />
                                            <Setter TargetName="ValueBox" Property="BorderBrush" Value="Transparent" />
                                            <Setter TargetName="ValueBox" Property="Foreground" Value="{StaticResource DimTextBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Save: the properties shown become the properties of every new object -->
                    <Button Grid.Row="3" Style="{StaticResource PanelButton}" Margin="8,4,8,6" Content="Save for all new objects"
                            Click="PropertiesSave_Click" IsEnabled="{Binding Properties.CanSave}"
                            ToolTip="Without Save, a change made while drawing is for that one object, and a change to a selected object is for that object only. Save makes the properties shown here the ones every new object gets." />

                    <TextBlock Grid.Row="4" Style="{StaticResource PanelHeader}" Text="OBJECT INFORMATION" />
                    <TextBlock Grid.Row="5" Margin="8,0,8,10" Text="{Binding StatusText}" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <!-- =========================== Command line =========================== -->
        <Border Grid.Row="2" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="84" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox x:Name="HistoryList" Grid.Row="0" BorderThickness="0" Background="Transparent" Focusable="False"
                         FontFamily="Consolas" ItemsSource="{Binding History}" ItemContainerStyle="{StaticResource PlainListItem}" />
                <Grid Grid.Row="1" Margin="6,2,6,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Prompt}" FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}" Margin="2,0,8,0" />
                    <TextBox x:Name="CommandBox" Grid.Column="1" FontFamily="Consolas"
                             Text="{Binding CommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Grid>
        </Border>

        <!-- ============================ Status bar ============================ -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="8,3" LastChildFill="False">
                <!-- What the automatic update is doing (test releases only); empty otherwise -->
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,4,0" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" Text="{Binding UpdateStatus}"
                           ToolTip="Automatic update status. Details are in the command history." />
                <TextBlock DockPanel.Dock="Left" Width="230" VerticalAlignment="Center" FontFamily="Consolas" Text="{Binding CoordinateText}"
                           Background="Transparent" ToolTip="Click to switch between absolute, distance&lt;angle and off">
                    <TextBlock.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding CycleCoordinateModeCommand}" />
                    </TextBlock.InputBindings>
                </TextBlock>
                <ToggleButton DockPanel.Dock="Left" Style="{StaticResource StatusToggle}" Content="OSNAP" IsChecked="{Binding OsnapOn, Mode=TwoWay}" MouseRightButtonUp="OsnapButton_RightClick" ToolTip="Object snap on/off (F3). Right-click to choose which snaps act automatically." />
                <ToggleButton DockPanel.Dock="Left" Style="{StaticResource StatusToggle}" Content="ORTHO" IsChecked="{Binding OrthoOn, Mode=TwoWay}" ToolTip="Restrict to horizontal / vertical (F8)" />
                <ToggleButton DockPanel.Dock="Left" Style="{StaticResource StatusToggle}" Content="POLAR" IsChecked="{Binding PolarOn, Mode=TwoWay}" ToolTip="Polar tracking: lock onto horizontal and vertical when the cursor is close to them (F10)" />
                <ToggleButton DockPanel.Dock="Left" Style="{StaticResource StatusToggle}" Content="OTRACK" IsChecked="{Binding TrackOn, Mode=TwoWay}" ToolTip="Object snap tracking (F11): hover over a snap point without clicking, then move away from it; the cursor locks onto a line through that point. Needs OSNAP on." />
                <ToggleButton DockPanel.Dock="Left" Style="{StaticResource StatusToggle}" Content="GRID" IsChecked="{Binding GridOn, Mode=TwoWay}" ToolTip="Show the grid (F7)" />
                <Border DockPanel.Dock="Left" Margin="8,0,2,0" Padding="9,2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2">
                    <TextBlock Text="MODEL" FontWeight="SemiBold" />
                </Border>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource DimTextBrush}" Text="{Binding StatusText}" />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,18,0" Text="{Binding CurrentLayerName, StringFormat='Layer: {0}'}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

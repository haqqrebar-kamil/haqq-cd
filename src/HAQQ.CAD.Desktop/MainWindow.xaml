<Window x:Class="HAQQ.CAD.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HAQQ.CAD.Desktop"
        Title="{Binding Title}"
        Width="1440" Height="900" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        PreviewTextInput="Window_PreviewTextInput">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================== Ribbon ============================== -->
        <TabControl x:Name="Ribbon" Grid.Row="0" SelectedIndex="1">
<TabItem Header="FILE" PreviewMouseLeftButtonDown="RibbonTab_Click">
<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
<StackPanel Orientation="Horizontal" Margin="2,0">
<HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Drawing">
<StackPanel Orientation="Horizontal">
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconNew}" Content="New" Command="{Binding NewCommand}" ToolTip="New drawing (Ctrl+N)" />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconOpen}" Content="Open" Command="{Binding OpenCommand}" ToolTip="Open an HCAD drawing (Ctrl+O)" />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconSave}" Content="Save" Command="{Binding SaveCommand}" ToolTip="Save (Ctrl+S)" />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconSaveAs}" Content="Save As" Command="{Binding SaveAsCommand}" ToolTip="Save under a new name" />
</StackPanel>
</HeaderedContentControl>
<HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Settings">
<StackPanel Orientation="Horizontal">
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconUnits}" Content="Units" Command="{Binding RunCommandCommand}" CommandParameter="UNITS" ToolTip="UNITS: the unit of this drawing (inches, feet, mm, cm or meters), how lengths are written and the precision. Changing the unit of a drawing with objects asks whether they keep their real size or their numbers." />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconUnits}" Content="New Dwg Units" Command="{Binding RunCommandCommand}" CommandParameter="NEWUNITS" ToolTip="NEWUNITS: the unit new drawings start in. Inches unless you change it; remembered on this computer. The open drawing is not changed." />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconLayoutRename}" Content="Company" Command="{Binding RunCommandCommand}" CommandParameter="COMPANY" ToolTip="COMPANY: your company's name, written at the top of the title block of new layouts. Remembered on this computer." />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconCrosshair}" Content="Crosshair" Command="{Binding RunCommandCommand}" CommandParameter="CURSORSIZE" ToolTip="CURSORSIZE: crosshair size, 1 to 100 percent of the screen" />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconGridSpacing}" Content="Grid Spacing" Command="{Binding RunCommandCommand}" CommandParameter="GRID" ToolTip="GRID: distance between the lines of the background grid. It is saved with the drawing. F7 shows or hides the grid." />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconShortcuts}" Content="Shortcuts" Command="{Binding RunCommandCommand}" CommandParameter="SHORTCUTS" ToolTip="SHORTCUTS: choose the short names you type to start each command" />
</StackPanel>
</HeaderedContentControl>
<HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Output">
<StackPanel Orientation="Horizontal">
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource GlyphPlot}" Content="Plot" Command="{Binding RunCommandCommand}" CommandParameter="PLOT" ToolTip="PLOT (PRINT): preview and print the open layout or the model, or make a PDF" />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconPdfOut}" Content="Export PDF" Command="{Binding RunCommandCommand}" CommandParameter="EXPORTPDF" ToolTip="EXPORTPDF: write layouts to a PDF as lines and text, each page exactly the size of its sheet - one file for all sheets, or a file per sheet." />
</StackPanel>
</HeaderedContentControl>
</StackPanel>
</ScrollViewer>
</TabItem>
<TabItem Header="HOME" PreviewMouseLeftButtonDown="RibbonTab_Click">
<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
<StackPanel Orientation="Horizontal" Margin="2,0">
<HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Draw">
<StackPanel Orientation="Horizontal">
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconLine}" Content="Line" Command="{Binding RunCommandCommand}" CommandParameter="LINE" ToolTip="LINE (L)" />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconPolyline}" Content="Polyline" Command="{Binding RunCommandCommand}" CommandParameter="PLINE" ToolTip="PLINE (PL)" />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconCircle}" Content="Circle &#x25BE;" Click="RibbonMenuButton_Click" ToolTip="CIRCLE (C): choose how to define the circle">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Center, Radius" Tag="CIRCLE" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Center, Diameter" Tag="CIRCLE D" Click="RibbonMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="2-Point" Tag="CIRCLE 2P" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="3-Point" Tag="CIRCLE 3P" Click="RibbonMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="Tan, Tan, Radius" Tag="CIRCLE TTR" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Tan, Tan, Tan" Tag="CIRCLE TTT" Click="RibbonMenuItem_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconArc}" Content="Arc &#x25BE;" Click="RibbonMenuButton_Click" ToolTip="ARC (A): choose how to define the arc">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="3-Point" Tag="ARC" Click="RibbonMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="Start, Center, End" Tag="ARC SCE" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Start, Center, Angle" Tag="ARC SCA" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Start, Center, Length" Tag="ARC SCL" Click="RibbonMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="Start, End, Angle" Tag="ARC SEA" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Start, End, Direction" Tag="ARC SED" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Start, End, Radius" Tag="ARC SER" Click="RibbonMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="Center, Start, End" Tag="ARC CSE" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Center, Start, Angle" Tag="ARC CSA" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Center, Start, Length" Tag="ARC CSL" Click="RibbonMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="Continue" Tag="ARC CONTINUE" Click="RibbonMenuItem_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
<StackPanel VerticalAlignment="Center">
<Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconRectangle}" Content="Rectangle" Command="{Binding RunCommandCommand}" CommandParameter="RECTANG" ToolTip="RECTANG (REC)" />
<Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconGridLines}" Content="Grid Lines" Command="{Binding RunCommandCommand}" CommandParameter="GRIDLINES" ToolTip="GRIDLINES (GL): grid line wizard - a rectangular or a sector grid with labels, on its own layer" />
<Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconGridAdd}" Content="Add Grid" Command="{Binding RunCommandCommand}" CommandParameter="GRIDADD" ToolTip="GRIDADD (GA): one more grid line beside an existing one - between two lines or past either end" />
</StackPanel>
</StackPanel>
</HeaderedContentControl>
<HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Modify">
<StackPanel Orientation="Horizontal">
<StackPanel VerticalAlignment="Center">
<Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconMove}" Content="Move" Command="{Binding RunCommandCommand}" CommandParameter="MOVE" ToolTip="MOVE (M)" />
<Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconCopy}" Content="Copy" Command="{Binding RunCommandCommand}" CommandParameter="COPY" ToolTip="COPY (CO)" />
<Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconOffset}" Content="Offset" Command="{Binding RunCommandCommand}" CommandParameter="OFFSET" ToolTip="OFFSET (O): parallel copy at a distance" />
</StackPanel>
<StackPanel VerticalAlignment="Center">
<Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconRotate}" Content="Rotate" Command="{Binding RunCommandCommand}" CommandParameter="ROTATE" ToolTip="ROTATE (RO): turn objects about a base point" />
<Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconMirror}" Content="Mirror" Command="{Binding RunCommandCommand}" CommandParameter="MIRROR" ToolTip="MIRROR (MI): reflect objects across a line" />
<Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconScale}" Content="Scale" Command="{Binding RunCommandCommand}" CommandParameter="SCALE" ToolTip="SCALE (SC): enlarge or reduce objects" />
</StackPanel>
<StackPanel VerticalAlignment="Center">
<Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconTrim}" Content="Trim" Command="{Binding RunCommandCommand}" CommandParameter="TRIM" ToolTip="TRIM (TR): click the part to remove; it is cut at the nearest crossings" />
<Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconExtend}" Content="Extend" Command="{Binding RunCommandCommand}" CommandParameter="EXTEND" ToolTip="EXTEND (EX): click near an end to lengthen it to the next object" />
<Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconJoin}" Content="Join" Command="{Binding RunCommandCommand}" CommandParameter="JOIN" ToolTip="JOIN (J): connect selected lines, arcs and open polylines that touch end to end into one polyline" />
</StackPanel>
<StackPanel VerticalAlignment="Center">
<Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconFillet}" Content="Fillet" Command="{Binding RunCommandCommand}" CommandParameter="FILLET" ToolTip="FILLET (F): round the corner between two lines (radius 0 = sharp corner)" />
<Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconChamfer}" Content="Chamfer" Command="{Binding RunCommandCommand}" CommandParameter="CHAMFER" ToolTip="CHAMFER (CHA): cut the corner between two lines" />
<Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconExplode}" Content="Explode" Command="{Binding RunCommandCommand}" CommandParameter="EXPLODE" ToolTip="EXPLODE (X): turn polylines into lines and arcs" />
</StackPanel>
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconErase}" Content="Erase" Command="{Binding RunCommandCommand}" CommandParameter="ERASE" ToolTip="ERASE (E, Delete)" />
</StackPanel>
</HeaderedContentControl>
<HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Annotation">
<StackPanel Orientation="Horizontal">
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconText}" Content="Text" Command="{Binding RunCommandCommand}" CommandParameter="TEXT" ToolTip="TEXT (T): words in a font with height, bold, italic, underline and angle; one line or several. Then click where it goes. Double-click a text to edit it." />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconDimLinear}" Content="Dimension &#x25BE;" Click="RibbonMenuButton_Click" ToolTip="Dimensions: choose the kind. Straight (DIM) measures horizontally or vertically between two points.">
<Button.ContextMenu>
<ContextMenu>
<MenuItem Header="Straight (horizontal / vertical)" Tag="DIM" Click="RibbonMenuItem_Click" />
<MenuItem Header="Aligned" Tag="DIMALIGN" Click="RibbonMenuItem_Click" />
<Separator />
<MenuItem Header="Radius" Tag="DIMRAD" Click="RibbonMenuItem_Click" />
<MenuItem Header="Diameter" Tag="DIMDIA" Click="RibbonMenuItem_Click" />
<MenuItem Header="Angle" Tag="DIMANGLE" Click="RibbonMenuItem_Click" />
<MenuItem Header="Arc length" Tag="DIMARCLEN" Click="RibbonMenuItem_Click" />
<Separator />
<MenuItem Header="Chain (one after another)" Tag="DIMCHAIN" Click="RibbonMenuItem_Click" />
<MenuItem Header="Stack (from one base)" Tag="DIMSTACK" Click="RibbonMenuItem_Click" />
</ContextMenu>
</Button.ContextMenu>
</Button>
<StackPanel VerticalAlignment="Center">
<Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconTable}" Content="Table" Command="{Binding RunCommandCommand}" CommandParameter="TABLE" ToolTip="TABLE (TB): rows and columns with a title and a header row. Fill it in, then click where it goes. Double-click a table to edit it." />
<Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconTextEdit}" Content="Edit Text" Command="{Binding RunCommandCommand}" CommandParameter="TEXTEDIT" ToolTip="TEXTEDIT (ED): click a text or a table to change it (the same as a double-click on it)" />
<Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconDimSettings}" Content="Dim Style" Command="{Binding RunCommandCommand}" CommandParameter="DIMSTYLE" ToolTip="DIMSTYLE (DST): dimension styles - text, arrows, extension lines and how lengths are written" />
</StackPanel>
</StackPanel>
</HeaderedContentControl>
<HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Layers">
<StackPanel Orientation="Horizontal">
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconLayers}" Content="Layers" Command="{Binding RunCommandCommand}" CommandParameter="LAYER" ToolTip="LAYER (LA): open the layer table (on/off, freeze, lock, name, colour, lineweight)" />
<StackPanel VerticalAlignment="Center" Width="176" Margin="2,0">
<ComboBox DropDownClosed="PropertyCombo_DropDownClosed" ItemsSource="{Binding Layers}" SelectedValuePath="Name"
                                  SelectedValue="{Binding Properties.SelectedLayerName, Mode=TwoWay}"
                                  ToolTip="The layer new objects are drawn on. With objects selected: their layer.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center" Background="{Binding ColorHex}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
<StackPanel Orientation="Horizontal" Margin="0,2,0,0"><Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconLayers}" Content="New Layer" Command="{Binding AddLayerCommand}" ToolTip="Create a layer" /><Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconLinetype}" Content="Linetype" Command="{Binding RunCommandCommand}" CommandParameter="LINETYPE" ToolTip="LINETYPE (LT): Linetype Manager - see every linetype, build your own with sliders, edit or delete" /></StackPanel>
<StackPanel Orientation="Horizontal"><Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconLinetype}" Content="LT Scale" Command="{Binding RunCommandCommand}" CommandParameter="LTSCALE" ToolTip="LTSCALE (LTS): make every dash and gap in the drawing longer or shorter" /><TextBlock Text="Plot" Foreground="{StaticResource DimTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="10,0,4,0" /><ToggleButton Style="{StaticResource FlagToggle}" Foreground="{StaticResource TextBrush}"
                                      Tag="{StaticResource GlyphPlot}" Content="{StaticResource GlyphNoPlot}"
                                      IsChecked="{Binding CurrentLayerPlots, Mode=TwoWay}"
                                      ToolTip="Plot switch of the current layer. Crossed out: the layer is shown on screen but will not be printed." /></StackPanel>
</StackPanel>
</StackPanel>
</HeaderedContentControl>
<HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Insert">
<StackPanel Orientation="Horizontal">
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconBlockLibrary}" Content="Blocks" Command="{Binding RunCommandCommand}" CommandParameter="INSERT" ToolTip="INSERT (I): the blocks of this drawing, your own library and the HAQQ library (furniture, bedroom, plumbing, kitchen, doors). Choose one and click where it goes." />
<StackPanel VerticalAlignment="Center">
<Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconBlockMake}" Content="Make Block" Command="{Binding RunCommandCommand}" CommandParameter="BLOCK" ToolTip="BLOCK (B): turn the selected objects into one block - select them, click the base point, type a name. EXPLODE (X) turns a block back into objects." />
<Button Style="{StaticResource RibbonSmallButton}" Tag="{StaticResource IconCopyPdf}" Content="Copy PDF" Command="{Binding RunCommandCommand}" CommandParameter="COPYPDF" ToolTip="COPYPDF (PDF): open a PDF drawing, choose a page, check its scale and layers, and place it as editable lines, polylines, arcs, circles and text. Works on PDFs that hold real line work (drawings exported from CAD); a scanned page is a picture and cannot be copied yet." />
</StackPanel>
</StackPanel>
</HeaderedContentControl>
<HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Properties">
<StackPanel Orientation="Horizontal">
<StackPanel VerticalAlignment="Center" Width="178" Margin="4,0">
<DockPanel Margin="0,1"><TextBlock DockPanel.Dock="Left" Width="62" VerticalAlignment="Center" Foreground="{StaticResource DimTextBrush}" FontSize="11" Text="Color" /><ComboBox DropDownClosed="PropertyCombo_DropDownClosed" ItemsSource="{Binding Properties.ColorNames}"
                                  SelectedItem="{Binding Properties.SelectedColor, Mode=TwoWay}"
                                  ToolTip="Colour of new objects (ByLayer uses the layer colour). With objects selected: their colour.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"
                                                Background="{Binding Converter={StaticResource ColorNameToBrush}}"
                                                BorderBrush="{StaticResource DimTextBrush}" BorderThickness="1" />
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox></DockPanel>
<DockPanel Margin="0,1"><TextBlock DockPanel.Dock="Left" Width="62" VerticalAlignment="Center" Foreground="{StaticResource DimTextBrush}" FontSize="11" Text="Linetype" /><ComboBox DropDownClosed="PropertyCombo_DropDownClosed" ItemsSource="{Binding Properties.LinetypeNames}"
                                  SelectedItem="{Binding Properties.SelectedLinetype, Mode=TwoWay}"
                                  ToolTip="Linetype of new objects (ByLayer uses the layer linetype). With objects selected: their linetype." /></DockPanel>
<DockPanel Margin="0,1"><TextBlock DockPanel.Dock="Left" Width="62" VerticalAlignment="Center" Foreground="{StaticResource DimTextBrush}" FontSize="11" Text="Weight" /><ComboBox DropDownClosed="PropertyCombo_DropDownClosed" ItemsSource="{Binding Properties.LineweightNames}"
                                  SelectedItem="{Binding Properties.SelectedLineweight, Mode=TwoWay}"
                                  ToolTip="Line thickness of new objects in millimetres (ByLayer uses the layer lineweight). With objects selected: their lineweight." /></DockPanel>
</StackPanel>
</StackPanel>
</HeaderedContentControl>
<HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Dimension Style" Visibility="{Binding DimensionBar.IsActive, Converter={StaticResource BoolToVisibility}}">
<StackPanel Orientation="Horizontal">
<StackPanel VerticalAlignment="Center" Margin="4,0,6,0" Width="150">
<TextBlock Text="Dimension style" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,0,0,3" />
<ComboBox DropDownClosed="PropertyCombo_DropDownClosed" ItemsSource="{Binding DimensionBar.StyleNames}"
                                      SelectedItem="{Binding DimensionBar.SelectedStyle, Mode=TwoWay}"
                                      ToolTip="The style new dimensions are drawn with. With dimensions selected: their style." />
</StackPanel>
<StackPanel VerticalAlignment="Center" Margin="4,0,6,0" Width="90">
<TextBlock Text="Text height" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,0,0,3" />
<TextBox KeyDown="EditBox_KeyDown" Text="{Binding DimensionBar.TextHeightText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="Text height of this style, in drawing units. Arrows and gaps change in proportion, for every dimension of the style." />
</StackPanel>
<StackPanel VerticalAlignment="Center" Margin="4,0,6,0" Width="90">
<TextBlock Text="Ends" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,0,0,3" />
<ComboBox DropDownClosed="PropertyCombo_DropDownClosed" ItemsSource="{Binding DimensionBar.ArrowNames}"
                                      SelectedItem="{Binding DimensionBar.SelectedArrow, Mode=TwoWay}"
                                      ToolTip="What is drawn at the ends of the dimension line, for every dimension of this style." />
</StackPanel>
</StackPanel>
</HeaderedContentControl>
</StackPanel>
</ScrollViewer>
</TabItem>
<TabItem Header="ANNOTATE" PreviewMouseLeftButtonDown="RibbonTab_Click">
<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
<StackPanel Orientation="Horizontal" Margin="2,0">
<HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Text">
<StackPanel Orientation="Horizontal">
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconText}" Content="Text" Command="{Binding RunCommandCommand}" CommandParameter="TEXT" ToolTip="TEXT (T): words in a font with height, bold, italic, underline and angle; one line or several. Then click where it goes. Double-click a text to edit it." />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconTable}" Content="Table" Command="{Binding RunCommandCommand}" CommandParameter="TABLE" ToolTip="TABLE (TB): rows and columns with a title and a header row. Fill it in, then click where it goes. Double-click a table to edit it." />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconTextEdit}" Content="Edit Text" Command="{Binding RunCommandCommand}" CommandParameter="TEXTEDIT" ToolTip="TEXTEDIT (ED): click a text or a table to change it (the same as a double-click on it)" />
</StackPanel>
</HeaderedContentControl>
<HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Dimensions">
<StackPanel Orientation="Horizontal">
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconDimLinear}" Content="Straight" Command="{Binding RunCommandCommand}" CommandParameter="DIM" ToolTip="DIM (DL): horizontal or vertical distance between two points. Place the line above or below for horizontal, beside for vertical." />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconDimAligned}" Content="Aligned" Command="{Binding RunCommandCommand}" CommandParameter="DIMALIGN" ToolTip="DIMALIGN (DA): true distance between two points, along the slope" />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconDimRadius}" Content="Radius" Command="{Binding RunCommandCommand}" CommandParameter="DIMRAD" ToolTip="DIMRAD (DR): radius of a circle or arc" />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconDimDiameter}" Content="Diameter" Command="{Binding RunCommandCommand}" CommandParameter="DIMDIA" ToolTip="DIMDIA (DD): diameter of a circle or arc" />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconDimAngle}" Content="Angle" Command="{Binding RunCommandCommand}" CommandParameter="DIMANGLE" ToolTip="DIMANGLE (DG): angle between two lines, or the angle an arc covers" />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconDimArc}" Content="Arc Length" Command="{Binding RunCommandCommand}" CommandParameter="DIMARCLEN" ToolTip="DIMARCLEN (DARC): length along an arc" />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconDimChain}" Content="Chain" Command="{Binding RunCommandCommand}" CommandParameter="DIMCHAIN" ToolTip="DIMCHAIN (DC): carry on from the last dimension, end to end on one line" />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconDimStack}" Content="Stack" Command="{Binding RunCommandCommand}" CommandParameter="DIMSTACK" ToolTip="DIMSTACK (DS): more dimensions from the same first point, each on its own line" />
</StackPanel>
</HeaderedContentControl>
<HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Dimension Style">
<StackPanel Orientation="Horizontal">
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconDimSettings}" Content="Settings" Command="{Binding RunCommandCommand}" CommandParameter="DIMSTYLE" ToolTip="DIMSTYLE (DST): dimension styles - text, arrows, extension lines and how lengths are written" />
<StackPanel VerticalAlignment="Center" Margin="4,0,6,0" Width="150">
<TextBlock Text="Dimension style" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,0,0,3" />
<ComboBox DropDownClosed="PropertyCombo_DropDownClosed" ItemsSource="{Binding DimensionBar.StyleNames}"
                                      SelectedItem="{Binding DimensionBar.SelectedStyle, Mode=TwoWay}"
                                      ToolTip="The style new dimensions are drawn with. With dimensions selected: their style." />
</StackPanel>
<StackPanel VerticalAlignment="Center" Margin="4,0,6,0" Width="90">
<TextBlock Text="Text height" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,0,0,3" />
<TextBox KeyDown="EditBox_KeyDown" Text="{Binding DimensionBar.TextHeightText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="Text height of this style, in drawing units. Arrows and gaps change in proportion, for every dimension of the style." />
</StackPanel>
<StackPanel VerticalAlignment="Center" Margin="4,0,6,0" Width="90">
<TextBlock Text="Ends" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,0,0,3" />
<ComboBox DropDownClosed="PropertyCombo_DropDownClosed" ItemsSource="{Binding DimensionBar.ArrowNames}"
                                      SelectedItem="{Binding DimensionBar.SelectedArrow, Mode=TwoWay}"
                                      ToolTip="What is drawn at the ends of the dimension line, for every dimension of this style." />
</StackPanel>
</StackPanel>
</HeaderedContentControl>
<HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Grid Lines">
<StackPanel Orientation="Horizontal">
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconGridLines}" Content="Grid Lines" Command="{Binding RunCommandCommand}" CommandParameter="GRIDLINES" ToolTip="GRIDLINES (GL): grid line wizard - a rectangular or a sector grid with labels, on its own layer" />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconGridAdd}" Content="Add Grid Line" Command="{Binding RunCommandCommand}" CommandParameter="GRIDADD" ToolTip="GRIDADD (GA): one more grid line beside an existing one - between two lines or past either end" />
</StackPanel>
</HeaderedContentControl>
</StackPanel>
</ScrollViewer>
</TabItem>
<TabItem Header="INSERT" PreviewMouseLeftButtonDown="RibbonTab_Click">
<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
<StackPanel Orientation="Horizontal" Margin="2,0">
<HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Block">
<StackPanel Orientation="Horizontal">
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconBlockLibrary}" Content="Block Library" Command="{Binding RunCommandCommand}" CommandParameter="INSERT" ToolTip="INSERT (I): the blocks of this drawing, your own library and the HAQQ library (furniture, bedroom, plumbing, kitchen, doors). Choose one and click where it goes." />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconBlockMake}" Content="Make Block" Command="{Binding RunCommandCommand}" CommandParameter="BLOCK" ToolTip="BLOCK (B): turn the selected objects into one block - select them, click the base point, type a name. EXPLODE (X) turns a block back into objects." />
</StackPanel>
</HeaderedContentControl>
<HeaderedContentControl Style="{StaticResource RibbonGroup}" Header="Drawing Copy">
<StackPanel Orientation="Horizontal">
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconCopyPdf}" Content="Copy from PDF" Command="{Binding RunCommandCommand}" CommandParameter="COPYPDF" ToolTip="COPYPDF (PDF): open a PDF drawing, choose a page, check its scale and layers, and place it as editable lines, polylines, arcs, circles and text. Works on PDFs that hold real line work (drawings exported from CAD); a scanned page is a picture and cannot be copied yet." />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconCalibrate}" Content="Calibrate" Command="{Binding RunCommandCommand}" CommandParameter="CALIBRATE" ToolTip="CALIBRATE (CAL): give the copied drawing (or the selected objects) its true size - click the two ends of a length you know and type that length. The correction is remembered for that PDF page." />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconCleanup}" Content="Clean Up" Command="{Binding RunCommandCommand}" CommandParameter="CLEANUP" ToolTip="CLEANUP (CLEAN): tidy the selected lines - make near-horizontal and near-vertical lines exact, remove doubled lines, merge pieces lying on one line, join lines that meet into polylines. Nothing moves further than the tolerance you type." />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconMove}" Content="Move" Command="{Binding RunCommandCommand}" CommandParameter="MOVE" ToolTip="MOVE (M): put the copied drawing somewhere else (it is still selected after placing)" />
<Button Style="{StaticResource RibbonLargeButton}" Tag="{StaticResource IconUndo}" Content="Undo Copy" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z): takes the whole copy back in one step, with the layers it made" />
</StackPanel>
</HeaderedContentControl>
</StackPanel>
</ScrollViewer>
</TabItem>
        </TabControl>
        <!-- Always at hand, whatever tab is open: undo, redo, zoom, pan, and the switch that folds the ribbon away -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,6,0">
<Button Style="{StaticResource RibbonIconButton}" Tag="{StaticResource IconUndo}" Content="Undo" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)" />
<Button Style="{StaticResource RibbonIconButton}" Tag="{StaticResource IconRedo}" Content="Redo" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)" />
<Border Width="1" Margin="5,4" Background="{StaticResource BorderBrush}" />
<Button Style="{StaticResource RibbonIconButton}" Tag="{StaticResource IconZoomGlass}" Content="Zoom &#x25BE;" Click="RibbonMenuButton_Click" ToolTip="ZOOM (Z): All, Window, Center, In, Out. The wheel zooms and a double-click on the wheel shows everything.">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="All (the whole drawing)" Tag="ZOOM A" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Window" Tag="ZOOM W" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Center" Tag="ZOOM C" Click="RibbonMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="In" Tag="ZOOM I" Click="RibbonMenuItem_Click" />
                                <MenuItem Header="Out" Tag="ZOOM O" Click="RibbonMenuItem_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
<Button Style="{StaticResource RibbonIconButton}" Tag="{StaticResource IconPan}" Content="Pan" Command="{Binding RunCommandCommand}" CommandParameter="PAN" ToolTip="PAN (P): hold the left button and drag to move the view; Enter or Esc to finish. The middle button pans at any time." />
<Border Width="1" Margin="5,4" Background="{StaticResource BorderBrush}" />
<Button x:Name="RibbonFoldButton" Style="{StaticResource RibbonIconButton}" Tag="{StaticResource IconRibbonFold}" Click="RibbonFold_Click" ToolTip="Fold the ribbon away to give the drawing more room; click again (or any tab) to bring it back" />
        </StackPanel>

        <!-- ============================ Work area ============================ -->
        <Grid Grid.Row="1">
            <!-- Properties are at the left (owner's request, 18 Nov); the right side is kept for the assistant panel. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PropertiesColumn" Width="270" MinWidth="170" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Centre: the CAD canvas -->
            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#21252B" ClipToBounds="True">
                    <local:CadCanvas x:Name="DrawingCanvas" />
                </Border>
            </Grid>

            <GridSplitter x:Name="PropertiesSplitter" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Focusable="False" />

            <!-- Left edge: strip that folds the properties panel away to the left and brings it back -->
            <Border Grid.Column="0" Width="18" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0" Cursor="Hand" MouseLeftButtonDown="PropertiesToggle_Click"
                    ToolTip="Hide or show the Properties panel">
                <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">
                    <TextBlock x:Name="PropertiesToggleArrow" Text="&#x00AB;" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock x:Name="PropertiesToggleLabel" Text="PROPERTIES" Visibility="Collapsed" Margin="0,10,0,0" FontSize="10"
                               HorizontalAlignment="Center" Foreground="{StaticResource DimTextBrush}">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Left panel: properties -->
            <Border x:Name="PropertiesPanel" Grid.Column="1" Background="{StaticResource PanelBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource PanelHeader}" Text="PROPERTIES" />

                    <StackPanel Grid.Row="1" Margin="8,0,8,6">
                        <TextBlock Text="{Binding Properties.Header}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,3" />
                        <TextBlock Text="{Binding Properties.Hint}" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Layer" />
                            <ComboBox Grid.Column="1" DropDownClosed="PropertyCombo_DropDownClosed" ItemsSource="{Binding Properties.LayerNames}"
                                      SelectedItem="{Binding Properties.SelectedLayerName, Mode=TwoWay}"
                                      ToolTip="Layer of the selected objects. While drawing: the layer of the object being drawn. Otherwise: the current layer for new objects." />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Color" />
                            <ComboBox Grid.Column="1" DropDownClosed="PropertyCombo_DropDownClosed" ItemsSource="{Binding Properties.ColorNames}"
                                      SelectedItem="{Binding Properties.SelectedColor, Mode=TwoWay}"
                                      ToolTip="ByLayer uses the colour of the layer.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"
                                                Background="{Binding Converter={StaticResource ColorNameToBrush}}"
                                                BorderBrush="{StaticResource DimTextBrush}" BorderThickness="1" />
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Linetype" />
                            <ComboBox Grid.Column="1" DropDownClosed="PropertyCombo_DropDownClosed" ItemsSource="{Binding Properties.LinetypeNames}"
                                      SelectedItem="{Binding Properties.SelectedLinetype, Mode=TwoWay}"
                                      ToolTip="ByLayer uses the linetype of the layer." />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Lineweight" />
                            <ComboBox Grid.Column="1" DropDownClosed="PropertyCombo_DropDownClosed" ItemsSource="{Binding Properties.LineweightNames}"
                                      SelectedItem="{Binding Properties.SelectedLineweight, Mode=TwoWay}"
                                      ToolTip="Line thickness in millimetres. ByLayer uses the lineweight of the layer." />
                        </Grid>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl Margin="8,0,8,8" ItemsSource="{Binding Properties.Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{Binding Label}" />
                                        <TextBox x:Name="ValueBox" Grid.Column="1" KeyDown="EditBox_KeyDown"
                                                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 IsReadOnly="{Binding IsReadOnly, Mode=OneWay}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                            <Setter TargetName="ValueBox" Property="Background" Value="Transparent" />
                                            <Setter TargetName="ValueBox" Property="BorderBrush" Value="Transparent" />
                                            <Setter TargetName="ValueBox" Property="Foreground" Value="{StaticResource DimTextBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Save: the properties shown become the properties of every new object -->
                    <Button Grid.Row="3" Style="{StaticResource PanelButton}" Margin="8,4,8,6" Content="Save for all new objects"
                            Click="PropertiesSave_Click" IsEnabled="{Binding Properties.CanSave}"
                            ToolTip="Without Save, a change made while drawing is for that one object, and a change to a selected object is for that object only. Save makes the properties shown here the ones every new object gets." />

                    <TextBlock Grid.Row="4" Style="{StaticResource PanelHeader}" Text="OBJECT INFORMATION" />
                    <TextBlock Grid.Row="5" Margin="8,0,8,10" Text="{Binding StatusText}" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <!-- =========================== Command line =========================== -->
        <Border Grid.Row="2" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="84" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox x:Name="HistoryList" Grid.Row="0" BorderThickness="0" Background="Transparent" Focusable="False"
                         FontFamily="Consolas" ItemsSource="{Binding History}" ItemContainerStyle="{StaticResource PlainListItem}" />
                <Grid Grid.Row="1" Margin="6,2,6,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Prompt}" FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}" Margin="2,0,8,0" />
                    <TextBox x:Name="CommandBox" Grid.Column="1" FontFamily="Consolas"
                             Text="{Binding CommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Grid>
        </Border>

        <!-- ============================ Status bar ============================ -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="2,3,8,3" LastChildFill="False">
                <!-- What the automatic update is doing (test releases only); empty otherwise -->
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,4,0" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" Text="{Binding UpdateStatus}"
                           ToolTip="Automatic update status. Details are in the command history." />
                <!-- Model and the layouts (sheets): click to open, + adds a layout, double-click a layout to rename it,
                     right-click for page setup, delete and plot. They sit at the very left of the bar; the menu button before
                     them holds every layout and viewport tool (there is no layout tab on the ribbon). -->
                <Button DockPanel.Dock="Left" Style="{StaticResource SpaceTab}" Content="&#x2261;" FontSize="15" Click="LayoutMenuButton_Click"
                        ToolTip="Layout tools: new layout, rename, delete, paper size, viewports (new, scale, fit, lock), plot and PDF" />
                <ScrollViewer DockPanel.Dock="Left" Margin="0" MaxWidth="560" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Hidden" Focusable="False" PreviewMouseWheel="SpaceTabs_MouseWheel">
                    <ItemsControl ItemsSource="{Binding SpaceTabs}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Button Style="{StaticResource SpaceTab}" Content="{Binding Name}" ToolTip="{Binding Detail}"
                                            Command="{Binding DataContext.SelectSpaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}" MouseRightButtonUp="SpaceTab_RightClick" MouseDoubleClick="SpaceTab_DoubleClick" />
                                    <TextBox MinWidth="90" VerticalAlignment="Center" Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}"
                                             IsVisibleChanged="SpaceTabBox_VisibleChanged" KeyDown="SpaceTabBox_KeyDown" LostKeyboardFocus="SpaceTabBox_LostFocus" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button DockPanel.Dock="Left" Style="{StaticResource SpaceTab}" Content="+" FontSize="14" FontWeight="Bold" Command="{Binding RunCommandCommand}" CommandParameter="NEWLAYOUT"
                        ToolTip="New layout: choose the paper, the border and title block, and whether it gets a viewport. Add as many as you need; double-click a layout tab to rename it, right-click for more." />
                <TextBlock DockPanel.Dock="Left" Width="230" Margin="14,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" Text="{Binding CoordinateText}"
                           Background="Transparent" ToolTip="Click to switch between absolute, distance&lt;angle and off">
                    <TextBlock.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding CycleCoordinateModeCommand}" />
                    </TextBlock.InputBindings>
                </TextBlock>
                <ToggleButton DockPanel.Dock="Left" Style="{StaticResource StatusToggle}" Content="OSNAP" IsChecked="{Binding OsnapOn, Mode=TwoWay}" MouseRightButtonUp="OsnapButton_RightClick" ToolTip="Object snap on/off (F3). Right-click to choose which snaps act automatically." />
                <ToggleButton DockPanel.Dock="Left" Style="{StaticResource StatusToggle}" Content="ORTHO" IsChecked="{Binding OrthoOn, Mode=TwoWay}" ToolTip="Restrict to horizontal / vertical (F8)" />
                <ToggleButton DockPanel.Dock="Left" Style="{StaticResource StatusToggle}" Content="POLAR" IsChecked="{Binding PolarOn, Mode=TwoWay}" ToolTip="Polar tracking: lock onto horizontal and vertical when the cursor is close to them (F10)" />
                <ToggleButton DockPanel.Dock="Left" Style="{StaticResource StatusToggle}" Content="OTRACK" IsChecked="{Binding TrackOn, Mode=TwoWay}" ToolTip="Object snap tracking (F11): hover over a snap point without clicking, then move away from it; the cursor locks onto a line through that point. Needs OSNAP on." />
                <ToggleButton DockPanel.Dock="Left" Style="{StaticResource StatusToggle}" Content="GRID" IsChecked="{Binding GridOn, Mode=TwoWay}" ToolTip="Show the background grid (F7). To change its spacing: FILE tab &gt; Grid Spacing (or type GRID)." />
                <Border DockPanel.Dock="Left" Margin="8,0,2,0" Padding="9,2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2"
                        ToolTip="Where you are working: MODEL (the drawing at real size), PAPER (a sheet), or inside a viewport of the sheet (the wheel and middle button then move the model in it; double-click outside or Esc to leave)">
                    <TextBlock Text="{Binding SpaceLabel}" FontWeight="SemiBold" />
                </Border>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource DimTextBrush}" Text="{Binding SheetStatus}" />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource DimTextBrush}" Text="{Binding StatusText}" />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,18,0" Text="{Binding UnitLabel, StringFormat='Units: {0}'}"
                           ToolTip="The unit of this drawing. FILE tab > Units changes it; lengths can also be typed with a unit in any drawing: 250mm, 2.5m, 30cm, 5'-6&quot;." />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,18,0" Text="{Binding CurrentLayerName, StringFormat='Layer: {0}'}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="HAQQ.CAD.Desktop.TableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="940" Height="620" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Size and title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <StackPanel Width="60" Margin="0,0,8,0">
                <TextBlock Text="Rows" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,0,0,3" />
                <TextBox Text="{Binding RowCountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="SizeBox_KeyDown" />
            </StackPanel>
            <StackPanel Width="60" Margin="0,0,8,0">
                <TextBlock Text="Columns" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,0,0,3" />
                <TextBox Text="{Binding ColumnCountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="SizeBox_KeyDown" />
            </StackPanel>
            <Button Style="{StaticResource PanelButton}" VerticalAlignment="Bottom" Content="Set size" Click="ApplySize_Click"
                    ToolTip="Makes the table this many rows and columns. Added ones are empty, at the bottom and at the right; what is typed in the others stays." />
            <StackPanel Width="300" Margin="14,0,0,0">
                <TextBlock Text="Title (across the top; leave empty for none)" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,0,0,3" />
                <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </StackPanel>

        <!-- 2. Look -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <StackPanel Width="190" Margin="0,0,8,0">
                <TextBlock Text="Font" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,0,0,3" />
                <ComboBox ItemsSource="{Binding Fonts}" SelectedItem="{Binding Font, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Width="90" Margin="0,0,8,0">
                <TextBlock Text="Text height" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,0,0,3" />
                <TextBox Text="{Binding TextHeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Height of a capital letter in the cells, in drawing units" />
            </StackPanel>
            <StackPanel Width="90" Margin="0,0,8,0">
                <TextBlock Text="Row height" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,0,0,3" />
                <TextBox Text="{Binding RowHeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="One height for every row. &quot;Varies&quot; leaves each row as it is (rows can be stretched one by one with their grips in the drawing)." />
            </StackPanel>
            <StackPanel Width="100" Margin="0,0,14,0">
                <TextBlock Text="Text in cells" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,0,0,3" />
                <ComboBox ItemsSource="{Binding JustifyNames}" SelectedItem="{Binding Justify, Mode=TwoWay}" />
            </StackPanel>
            <CheckBox VerticalAlignment="Bottom" Margin="0,0,0,4" Content="First row is a header (bold, centred)" IsChecked="{Binding HeaderRow, Mode=TwoWay}" />
        </StackPanel>

        <!-- 3. Rows and columns in and out, at the cell the cursor is in -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,6">
            <TextBlock Style="{StaticResource FieldLabel}" Text="At the cell you are in:" />
            <Button Style="{StaticResource PanelButton}" Content="Row above" Tag="RowAbove" Click="Structure_Click" />
            <Button Style="{StaticResource PanelButton}" Content="Row below" Tag="RowBelow" Click="Structure_Click" />
            <Button Style="{StaticResource PanelButton}" Content="Delete row" Tag="RowDelete" Click="Structure_Click" />
            <Border Width="1" Margin="8,2" Background="{StaticResource BorderBrush}" />
            <Button Style="{StaticResource PanelButton}" Content="Column left" Tag="ColumnLeft" Click="Structure_Click" />
            <Button Style="{StaticResource PanelButton}" Content="Column right" Tag="ColumnRight" Click="Structure_Click" />
            <Button Style="{StaticResource PanelButton}" Content="Delete column" Tag="ColumnDelete" Click="Structure_Click" />
        </StackPanel>

        <!-- 4. The cells: the first line holds each column's width -->
        <Border Grid.Row="3" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                <Grid x:Name="CellGrid" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="4" Margin="0,8,0,0" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Text="{Binding Message}" />

        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap"
                       Text="Tab goes to the next cell. In the drawing: double-click the table to come back here; its grips change the width of a column and the height of a row." />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource PanelButton}" Content="{Binding CommitLabel}" Click="Commit_Click" />
                <Button Style="{StaticResource PanelButton}" Content="Cancel" Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

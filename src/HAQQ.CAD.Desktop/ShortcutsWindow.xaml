<Window x:Class="HAQQ.CAD.Desktop.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command Shortcuts"
        Width="820" Height="640" MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Find a command" />
            <TextBox x:Name="FilterBox" Grid.Column="1" Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap"
                       Text="Type the shortcuts for a command, separated by commas. The full command name always works." />
        </Grid>

        <!-- Column titles: the widths match the row template below -->
        <Border Grid.Row="1" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="5,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource ColumnHeader}" Text="Command" />
                <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="What it does" />
                <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="Shortcuts" />
                <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="Standard" />
            </Grid>
        </Border>

        <!-- One row per command -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Rows}" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Continue">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="NameText" Grid.Column="0" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Command}" />
                        <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                        <TextBox Grid.Column="2" Margin="4,0" CharacterCasing="Upper"
                                 Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource DimTextBrush}" Text="{Binding DefaultText}" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsChanged}" Value="True">
                            <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3" Margin="0,8,0,0" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Text="{Binding Message}" />

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource PanelButton}" Content="Reset all to standard" Click="ResetAll_Click" />
            <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap"
                       Text="Commands shown in orange differ from the standard. Shortcuts are kept on this computer for your Windows user." />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource PanelButton}" Content="Save" Click="Save_Click" />
                <Button Style="{StaticResource PanelButton}" Content="Cancel" Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

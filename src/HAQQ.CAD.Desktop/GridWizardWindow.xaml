<Window x:Class="HAQQ.CAD.Desktop.GridWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HAQQ.CAD.Desktop"
        Title="Grid Lines"
        Width="980" Height="640" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Margin" Value="0,12,0,5" />
        </Style>
        <Style x:Key="Tip" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="110,1,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- What to draw -->
        <ScrollViewer Grid.Column="0" Grid.Row="0" Margin="0,0,10,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="28" /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Kind of grid" />
                    <ComboBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding KindNames}" SelectedItem="{Binding SelectedKind, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Name" />
                    <TextBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="The grid lines go on a layer of this name" />
                </Grid>
                <TextBlock Style="{StaticResource Tip}" Text="The grid lines go on a layer with this name, so they stay apart from everything else." />

                <!-- Rectangular -->
                <StackPanel Visibility="{Binding IsRectangular, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Section}" Text="LINES COUNTED ALONG X" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="28" /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Spacings" />
                        <TextBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Text="{Binding XSpacings, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Labels" />
                        <TextBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="{Binding XLabels, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Labels at" />
                        <ComboBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding XLabelEndNames}" SelectedItem="{Binding SelectedXLabelEnds, Mode=TwoWay}" />
                    </Grid>

                    <TextBlock Style="{StaticResource Section}" Text="LINES COUNTED ALONG Y" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="28" /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Spacings" />
                        <TextBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Text="{Binding YSpacings, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Labels" />
                        <TextBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="{Binding YLabels, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Labels at" />
                        <ComboBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding YLabelEndNames}" SelectedItem="{Binding SelectedYLabelEnds, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Tip}" Text="Spacings: separate with commas; 4x20' means four spaces of 20 feet. Labels: type the first one (A or 1) and the rest are counted on, or type them all: 1, 2, 3, 3.5, 4." />

                    <TextBlock Style="{StaticResource Section}" Text="PLACE" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="28" /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Origin X" />
                        <TextBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Text="{Binding OriginX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" Margin="0" Text="Y" />
                        <TextBox Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Text="{Binding OriginY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Rotation (deg)" />
                        <TextBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Rotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>

                <!-- Sector -->
                <StackPanel Visibility="{Binding IsSector, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Section}" Text="STRAIGHT LINES (FANNING OUT)" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="28" /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Angles between" />
                        <TextBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Text="{Binding AngleSpacings, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="In degrees: 6x15 means six spaces of 15 degrees" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="First line at (deg)" />
                        <TextBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="{Binding StartAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Counter-clockwise from the X axis" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Labels" />
                        <TextBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Text="{Binding RadialLabels, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Labels at" />
                        <ComboBox Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding RadialLabelEndNames}" SelectedItem="{Binding SelectedRadialLabelEnds, Mode=TwoWay}" />
                    </Grid>

                    <TextBlock Style="{StaticResource Section}" Text="ARCS (ACROSS THE LINES)" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="28" /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Radius, spacings" />
                        <TextBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Text="{Binding RingSpacings, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="The radius of the first arc, then the distances between the arcs" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Labels" />
                        <TextBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="{Binding RingLabels, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Labels at" />
                        <ComboBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding RingLabelEndNames}" SelectedItem="{Binding SelectedRingLabelEnds, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Tip}" Text="The first number is the radius of the first arc; the others are the distances between arcs. Labels are counted on from the first one you type." />

                    <TextBlock Style="{StaticResource Section}" Text="PLACE" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Center X" />
                        <TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding OriginX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" Margin="0" Text="Y" />
                        <TextBox Grid.Column="3" VerticalAlignment="Center" Text="{Binding OriginY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>

                <!-- Both kinds -->
                <TextBlock Style="{StaticResource Section}" Text="LOOK" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="28" /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Linetype" />
                    <ComboBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding LinetypeNames}" SelectedItem="{Binding SelectedLinetype, Mode=TwoWay}" ToolTip="Linetype of the grid's layer" />
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Line overrun" />
                    <TextBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Extension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="How far every line runs past the last crossing" />
                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Label circle size" />
                    <TextBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Text="{Binding BubbleSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Diameter of the circle round each label" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- The picture -->
        <Grid Grid.Column="1" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <local:EntityPreview Entities="{Binding Preview}" />
            </Border>
            <TextBlock Grid.Row="1" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Summary}" />
        </Grid>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Text="{Binding Error}" />

        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Afterwards: click a grid line to select the whole grid, double-click for one line. Drag an end to lengthen a line. Add Grid Line puts one more beside any line." />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <Button Style="{StaticResource PanelButton}" Content="Place by clicking in the drawing" Click="PlaceByClick_Click" IsEnabled="{Binding CanCreate}" />
                <Button Style="{StaticResource PanelButton}" Content="Place at the typed origin" Click="Create_Click" IsEnabled="{Binding CanCreate}" />
                <Button Style="{StaticResource PanelButton}" Content="Cancel" Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

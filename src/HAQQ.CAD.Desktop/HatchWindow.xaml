<Window x:Class="HAQQ.CAD.Desktop.HatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HAQQ.CAD.Desktop"
        Title="{Binding WindowTitle}"
        Width="1000" Height="640" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <!-- Groups, and a search across all of them -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Text="FIND" Margin="0,0,0,4" />
            <TextBox DockPanel.Dock="Top" Margin="0,0,0,12" Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Part of a name (brick, concrete, ansi ...): looks in every group at once" />
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Text="GROUPS" Margin="0,0,0,4" />
            <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category, Mode=TwoWay}" />
        </DockPanel>

        <!-- The patterns of the group, each with a sample -->
        <ListBox Grid.Column="1" Margin="10,0" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Items_MouseDoubleClick">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="120" Margin="4" ToolTip="{Binding Title}">
                        <local:EntityPreview Width="120" Height="84" Entities="{Binding Entities}" />
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="&#x2605;" Foreground="{StaticResource AccentBrush}" ToolTip="One of your favorites"
                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- The chosen pattern and how it is drawn -->
        <DockPanel Grid.Column="2" LastChildFill="False">
            <Border DockPanel.Dock="Top" Height="170" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <local:EntityPreview Entities="{Binding Preview}" />
            </Border>
            <TextBlock DockPanel.Dock="Top" Margin="0,8,0,0" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Selected.Title}" />
            <TextBlock DockPanel.Dock="Top" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource DimTextBrush}" Text="{Binding SpacingText}" />
            <TextBlock DockPanel.Dock="Top" Margin="0,2,0,0" Foreground="{StaticResource DimTextBrush}" Text="{Binding AreaText, StringFormat='Area of this hatch: {0}'}"
                       Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock DockPanel.Dock="Top" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"
                       Text="Its boundary objects no longer close around an area, so it has kept the area it had. Close the boundary again, or switch off Follow the boundary."
                       Visibility="{Binding BoundaryLost, Converter={StaticResource BoolToVisibility}}" />

            <Grid DockPanel.Dock="Top" Margin="0,12,0,0" IsEnabled="{Binding IsPattern}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Scale" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,0,0,3" />
                    <TextBox Text="{Binding ScaleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="How coarse the pattern is: 2 puts its lines twice as far apart. Auto picks a scale to suit the first area. It does not change the area." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="4,0,0,0">
                    <Button Style="{StaticResource PanelButton}" Content="&#x00F7;2" Click="ScaleDown_Click" ToolTip="Twice as fine" />
                    <Button Style="{StaticResource PanelButton}" Content="&#x00D7;2" Click="ScaleUp_Click" ToolTip="Twice as coarse" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Angle" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,0,0,3" />
                    <TextBox Text="{Binding AngleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Degrees the pattern is turned, counter-clockwise (ANSI31 is already drawn at 45). The area is not turned." />
                </StackPanel>
            </Grid>

            <TextBlock DockPanel.Dock="Top" Text="Openings inside the area" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,10,0,3" />
            <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding IslandNames}" SelectedItem="{Binding Islands, Mode=TwoWay}"
                      ToolTip="A closed shape inside the area (a column in a slab, a hole in a plate) is an opening." />

            <TextBlock DockPanel.Dock="Top" Text="Gap tolerance" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,10,0,3" />
            <TextBox DockPanel.Dock="Top" Text="{Binding GapText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="The largest opening between two boundary lines that is still treated as closed, in drawing units. 0: the lines must meet. The drawing itself is not changed." />

            <CheckBox DockPanel.Dock="Top" Margin="0,10,0,0" IsChecked="{Binding Associative, Mode=TwoWay}" IsEnabled="{Binding CanFollow}"
                      Content="Follow the boundary (associative)" Foreground="{StaticResource TextBrush}"
                      ToolTip="The hatch remembers the objects around it and reshapes itself when they are moved, stretched or edited." />
            <CheckBox DockPanel.Dock="Top" Margin="0,6,0,0" IsChecked="{Binding OriginAtCorner, Mode=TwoWay}"
                      Content="Start the pattern at the area's lower-left corner" Foreground="{StaticResource TextBrush}"
                      Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibility}}"
                      ToolTip="Off: the pattern is laid out from the drawing's 0,0, so neighbouring hatches line up. On: a brick or tile starts whole at the corner of each area." />

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource PanelButton}" Content="Pick points" Click="Pick_Click" FontWeight="SemiBold"
                        Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Then click inside each closed area to hatch it; Enter finishes" />
                <Button Style="{StaticResource PanelButton}" Content="Select objects" Click="Select_Click"
                        Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Then select the closed shapes (or the lines that meet) around the area and press Enter" />
                <Button Style="{StaticResource PanelButton}" Content="Apply" Click="Apply_Click" FontWeight="SemiBold"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" ToolTip="Change this hatch" />
                <Button Style="{StaticResource PanelButton}" Content="Cancel" Click="Close_Click" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                <Button Style="{StaticResource PanelButton}" Content="{Binding FavoriteLabel}" Click="Favorite_Click"
                        ToolTip="Favorites are kept on this computer and have a group of their own" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Margin="0,0,0,8" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Text="{Binding Message}" />
        </DockPanel>
    </Grid>
</Window>

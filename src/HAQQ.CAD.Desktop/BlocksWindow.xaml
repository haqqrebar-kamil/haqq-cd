<Window x:Class="HAQQ.CAD.Desktop.BlocksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HAQQ.CAD.Desktop"
        Title="Block Library"
        Width="1040" Height="660" MinWidth="820" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <!-- Groups, and a search across all of them -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Text="FIND" Margin="0,0,0,4" />
            <TextBox DockPanel.Dock="Top" x:Name="FilterBox" Margin="0,0,0,12" Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Part of a name (sink, door, bed ...): looks in every group at once" />
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Text="GROUPS" Margin="0,0,0,4" />
            <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category, Mode=TwoWay}" />
        </DockPanel>

        <!-- The blocks of the group -->
        <ListBox Grid.Column="1" Margin="10,0" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Items_MouseDoubleClick">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="150" Margin="4" ToolTip="{Binding Description}">
                        <local:EntityPreview Width="150" Height="104" Entities="{Binding Entities}" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Size}" Foreground="{StaticResource DimTextBrush}" FontSize="11" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- The chosen block and how it is placed -->
        <DockPanel Grid.Column="2" LastChildFill="False">
            <Border DockPanel.Dock="Top" Height="190" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <local:EntityPreview Entities="{Binding Selected.Entities}" />
            </Border>
            <TextBlock DockPanel.Dock="Top" Margin="0,8,0,0" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Selected.Name}" />
            <TextBlock DockPanel.Dock="Top" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource DimTextBrush}" Text="{Binding Selected.Description}" />
            <TextBlock DockPanel.Dock="Top" Margin="0,2,0,0" Foreground="{StaticResource DimTextBrush}" Text="{Binding Selected.Size, StringFormat='Size in this drawing: {0}'}" />

            <Grid DockPanel.Dock="Top" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Scale" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,0,0,3" />
                    <TextBox Text="{Binding ScaleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="1 = the size shown. 2 = twice as large." />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Angle" Foreground="{StaticResource DimTextBrush}" FontSize="11" Margin="1,0,0,3" />
                    <TextBox Text="{Binding RotationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Degrees, counter-clockwise. Both can also be changed while placing (Rotate, Scale)." />
                </StackPanel>
            </Grid>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource PanelButton}" Content="Place in drawing" Click="Insert_Click" IsEnabled="{Binding CanInsert}" />
                <Button Style="{StaticResource PanelButton}" Content="Close" Click="Close_Click" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                <Button Style="{StaticResource PanelButton}" Content="Keep in my library" Click="SaveToLibrary_Click" IsEnabled="{Binding CanSaveToLibrary}"
                        ToolTip="Keeps this block of the drawing on this computer, so it can be placed in any drawing" />
                <Button Style="{StaticResource PanelButton}" Content="Delete" Click="Delete_Click" IsEnabled="{Binding CanDelete}"
                        ToolTip="Deletes a block of this drawing that is not placed anywhere, or a block of your library. The HAQQ library cannot be changed." />
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Margin="0,0,0,8" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Text="{Binding Message}" />
            <TextBlock DockPanel.Dock="Bottom" Margin="0,0,0,8" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap"
                       Text="After Place: each click puts one down, Enter finishes. The HAQQ symbols are held by the middle of their back edge, so they sit on a wall line. Sizes are typical ones: check them against the real product." />
        </DockPanel>
    </Grid>
</Window>

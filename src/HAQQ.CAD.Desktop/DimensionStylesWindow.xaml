<Window x:Class="HAQQ.CAD.Desktop.DimensionStylesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HAQQ.CAD.Desktop"
        Title="Dimension Settings"
        Width="900" Height="700" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Margin" Value="0,12,0,5" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The styles of the drawing -->
        <Grid Grid.Column="0" Grid.Row="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource Section}" Margin="0,0,0,5" Text="DIMENSION STYLES" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Styles}" SelectedItem="{Binding Selected, Mode=TwoWay}" MouseDoubleClick="StyleList_MouseDoubleClick" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Foreground="{StaticResource DimTextBrush}" Text="Current: " />
                <TextBlock FontWeight="SemiBold" Text="{Binding CurrentName}" />
            </StackPanel>
            <Button Grid.Row="3" Style="{StaticResource PanelButton}" Margin="0,6,0,0" Content="Set current" Command="{Binding SetCurrentCommand}"
                    ToolTip="New dimensions are drawn with the current style (or double-click a style)" />
            <StackPanel Grid.Row="4" Margin="0,12,0,0">
                <TextBlock Foreground="{StaticResource DimTextBrush}" Text="Name for a new style" Margin="0,0,0,3" />
                <TextBox x:Name="NewNameBox" Text="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Style="{StaticResource PanelButton}" Margin="0,5,0,0" Content="+ New style (copy of the selected one)" Click="New_Click" />
            </StackPanel>
            <Button Grid.Row="5" Style="{StaticResource PanelButton}" Margin="0,5,0,0" Content="Delete style" Command="{Binding DeleteCommand}"
                    ToolTip="A style can be deleted when no dimension uses it and it is not the current one. Standard always stays." />
        </Grid>

        <!-- The selected style -->
        <Grid Grid.Column="1" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="230" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" Text="{Binding Summary}" />
            <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <local:DimensionPreview StyleValues="{Binding PreviewStyle}" Units="{Binding DrawingSettings}" />
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <Grid Margin="0,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Sizes and ends -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Section}" Text="TEXT" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="26" /><RowDefinition Height="26" /></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Text height" />
                            <TextBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" KeyDown="EditBox_KeyDown" Text="{Binding TextHeightText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="In drawing units" />
                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Gap above the line" />
                            <TextBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" KeyDown="EditBox_KeyDown" Text="{Binding TextGapText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <TextBlock Style="{StaticResource Section}" Text="ENDS OF THE DIMENSION LINE" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="26" /><RowDefinition Height="26" /></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Shape" />
                            <ComboBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding ArrowNames}" SelectedItem="{Binding SelectedArrow, Mode=TwoWay}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Size" />
                            <TextBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" KeyDown="EditBox_KeyDown" Text="{Binding ArrowSizeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <TextBlock Style="{StaticResource Section}" Text="EXTENSION LINES" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="26" /><RowDefinition Height="26" /></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Gap from the point" />
                            <TextBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" KeyDown="EditBox_KeyDown" Text="{Binding ExtensionOffsetText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Past the dimension line" />
                            <TextBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" KeyDown="EditBox_KeyDown" Text="{Binding ExtensionBeyondText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <TextBlock Style="{StaticResource Section}" Text="ANGLES" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Decimal places" />
                            <ComboBox Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding AngleNames}" SelectedItem="{Binding SelectedAngleDecimals, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>

                    <!-- How lengths are written -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Section}" Text="HOW LENGTHS ARE WRITTEN" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26" /><RowDefinition Height="26" /><RowDefinition Height="26" /><RowDefinition Height="26" />
                                <RowDefinition Height="26" /><RowDefinition Height="26" /><RowDefinition Height="26" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Format" />
                            <ComboBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding FormatNames}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Decimal places" />
                            <ComboBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" IsEnabled="{Binding HasOwnFormat}" ItemsSource="{Binding DecimalNames}" SelectedItem="{Binding SelectedDecimals, Mode=TwoWay}" ToolTip="Used by the Decimal format" />
                            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Smallest fraction" />
                            <ComboBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" IsEnabled="{Binding HasOwnFormat}" ItemsSource="{Binding FractionNames}" SelectedItem="{Binding SelectedFraction, Mode=TwoWay}" ToolTip="Used by the two formats with fractions" />
                            <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Round off to" />
                            <TextBox Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" KeyDown="EditBox_KeyDown" Text="{Binding RoundOffText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="The value is rounded to the nearest multiple of this, for example 1/2. 0 = no rounding." />
                            <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Scale factor" />
                            <TextBox Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" KeyDown="EditBox_KeyDown" Text="{Binding ScaleFactorText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="The measured length is multiplied by this before it is written. 1 = as measured." />
                            <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Text in front" />
                            <TextBox Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" KeyDown="EditBox_KeyDown" Text="{Binding Prefix, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="Text behind" />
                            <TextBox Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" KeyDown="EditBox_KeyDown" Text="{Binding Suffix, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <TextBlock Style="{StaticResource Section}" Text="FEET AND INCHES" />
                        <CheckBox Margin="0,2" IsChecked="{Binding SuppressZeroFeet, Mode=TwoWay}" Content="Leave out 0 feet  (6&quot; instead of 0'-6&quot;)" />
                        <CheckBox Margin="0,4" IsChecked="{Binding SuppressZeroInches, Mode=TwoWay}" Content="Leave out 0 inches  (5' instead of 5'-0&quot;)" />

                        <TextBlock Style="{StaticResource Section}" Text="EXAMPLE" />
                        <TextBlock Text="{Binding Example}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Text="{Binding Message}" />

        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="A change is applied at once, to the style and to every dimension drawn with it. Each change can be undone with Ctrl+Z in the drawing window. Sizes are in drawing units." />
            <Button Grid.Column="1" Style="{StaticResource PanelButton}" Content="Close" Click="Close_Click" Margin="10,0,0,0" />
        </Grid>
    </Grid>
</Window>

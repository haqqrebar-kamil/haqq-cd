<Project>
  <PropertyGroup>
    <!-- Target framework for every project. Override with -p:HaqqTfm=net8.0 if needed. -->
    <HaqqTfm Condition="'$(HaqqTfm)' == ''">net10.0</HaqqTfm>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.2.0</Version>
    <Company>HAQQ Construction</Company>
    <Product>HAQQ CAD</Product>
    <Copyright>Copyright (c) HAQQ Construction / HAQQ Rebar</Copyright>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
